# =============================================================================
# Quantum Wager — environment
# Copy to `.env` (and/or `.env.local`) and fill in. NEVER commit real secrets.
# All NEXT_PUBLIC_* vars are exposed to the browser — keep secrets out of them.
# =============================================================================

# -------- Frontend (NEXT_PUBLIC_*) -------------------------------------------

# REST backend base URL. Leave EMPTY to use the in-repo Next.js API (same-origin
# — recommended for local dev). Set to an external backend to override, e.g.
# https://quantum-wager.onrender.com
NEXT_PUBLIC_API_URL=

# App mode is informational only. Demo/sample data is NEVER rendered unless you
# explicitly opt in with NEXT_PUBLIC_DEMO_MODE=true below. Default is production.
NEXT_PUBLIC_APP_MODE=production

# Luxury UI theme (premium "Quantum Wager Design System").
# "true" enables the gold/charcoal luxury theme; unset/"false" = original UI.
NEXT_PUBLIC_LUXURY_UI=true

# Opt IN to local illustrative demo/seed data (default OFF). Leave unset for
# production/devnet — the app then only ever shows real live data or empty states.
# NEXT_PUBLIC_DEMO_MODE=true

# =============================================================================
# !! DEVNET-ONLY / DEMO-ONLY. There is NO real-money or mainnet path. Any RPC URL
# !! containing "mainnet" (e.g. api.mainnet-beta.solana.com) is INTENTIONALLY
# !! REJECTED at boot, and SOLANA_NETWORK must be exactly "devnet". The app fails
# !! loudly otherwise (see lib/solanaNetwork.ts + server/env.ts).
# =============================================================================

# Solana network — must be "devnet".
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Frontend RPC (exposed to the BROWSER). Prefer the keyless public devnet
# endpoint and keep authenticated keys SERVER-SIDE (ANCHOR_PROVIDER_URL below).
# If you MUST use a keyed URL here, it has to be a BROWSER-RESTRICTED, DEVNET-ONLY
# key (lock it to your domain in the provider console) — it is publicly visible:
#   NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_BROWSER_RESTRICTED_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# On-chain program id (Anchor prediction-market program, DEVNET). Real, deployed.
# Used by lib/solana.ts (frontend) and the server. Override to point at your own.
NEXT_PUBLIC_PROGRAM_ID=C8SAQXW3qhWTT1uGdpSegU466qTQAKQs3JB15TQ8toSc
PROGRAM_ID=C8SAQXW3qhWTT1uGdpSegU466qTQAKQs3JB15TQ8toSc

# -------- Backend (server-only — NOT exposed to the browser) -----------------

# Database — PostgreSQL (required).
#   Local dev:  run a local Postgres, e.g.
#               postgresql://postgres:postgres@localhost:5432/quantum_wager?schema=public
#               (or `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`)
#   Vercel/prod: use a managed Postgres (Vercel Postgres / Neon / Supabase) and
#               include sslmode=require:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# JWT signing secret for wallet-auth sessions. MUST be a strong value in prod;
# the server refuses to boot in production with the insecure default below.
JWT_SECRET="dev-only-insecure-secret-change-me"

# Prefix of the message wallets sign at login (the nonce is appended).
WALLET_AUTH_MESSAGE="Sign this message to login to Quantum: "

# Oracle resolution mode: dev | admin | provider
# "admin" = market outcomes are set by a trusted admin key (recorded honestly as
# source="admin", not pretended on-chain). On-chain settle/claim still happens via
# the program's instructions; resolutions are persisted with source/status/audit.
ORACLE_MODE="admin"

# Key required to resolve markets/fast-bets/battles via the admin resolver and
# the oracle webhook. Change this for any shared environment.
ADMIN_RESOLUTION_KEY="dev-admin-key-change-me"

# Bearer secret for the scheduled endpoints (`vercel.json` crons hit
# /api/fast-bets/generate + /api/fast-bets/auto-resolve with
# `Authorization: Bearer <CRON_SECRET>`). REQUIRED for the fast-bet loop to run
# in production — when unset, cron requests are always rejected.
CRON_SECRET="change-me-strong-random"

# -------- Pyth Hermes price oracle (provider mode) --------------------------
# Pyth Hermes is a PUBLIC, keyless HTTP price service — no API key required.
# Used when ORACLE_MODE="provider" to derive market outcomes from a REAL feed.

# Hermes base URL (default is the public mainnet endpoint; rarely needs changing).
PYTH_HERMES_URL="https://hermes.pyth.network"

# Select the real Pyth provider. Set to "pyth" to use PythHermesProvider instead
# of the loud stub. (Setting PYTH_FEED_IDS below ALSO enables it automatically.)
# RECOMMENDED in production: without it, generated fast-bet rounds get
# startPrice=null and can never auto-resolve.
ORACLE_PROVIDER="pyth"

# Per-symbol price-feed ids: comma-separated SYMBOL=hexid pairs. Each id is the
# canonical 32-byte (64-hex) Pyth price-feed id from the official catalog:
#   https://pyth.network/developers/price-feed-ids   (pick the "Crypto" feeds)
# SOL/USD ships as a VERIFIED built-in default (confirmed against the live Pyth
# catalog + price endpoint), so it works out-of-the-box once provider mode is on.
# Any OTHER symbol you resolve must be mapped here, or it fails loudly rather
# than resolving off a guessed feed. Values here are merged over the built-ins.
# Example (replace <...> with the verified id copied from the catalog above):
#   PYTH_FEED_IDS="BTC/USD=0x<canonical 64-hex Pyth BTC/USD id>"
# PYTH_FEED_IDS="BTC/USD=0x..."

# Optional: enable rate limiting ("true"/unset).
RATE_LIMIT_ENABLED="false"

# Optional distributed rate-limit backend (Upstash Redis REST). Leave BOTH unset
# to keep the default in-memory fixed-window limiter (single-node). When BOTH are
# set, the limiter counts via the Upstash REST API (plain fetch, no SDK) so the
# window is shared across serverless instances. Get these from the Upstash
# console (REST URL + REST token). If the backend is unreachable the limiter
# fails OPEN (logs + allows) — it never hard-fails a request.
# RATE_LIMIT_REDIS_URL="https://<your-db>.upstash.io"
# RATE_LIMIT_REDIS_TOKEN="<your-upstash-rest-token>"

# -------- Monitoring (optional, no-op by default) ---------------------------
# Provider-agnostic error monitoring. Leave MONITORING_DSN unset to disable
# entirely (no events are sent — default). When set, unhandled 5xx errors are
# POSTed as a minimal JSON event ({level,message,stack,context,timestamp}) to
# this endpoint via plain fetch (no SDK). Point it at any HTTP collector.
# MONITORING_ENABLED="false" forces monitoring off even if a DSN is present.
# MONITORING_DSN="https://<your-collector>/ingest"
# MONITORING_ENABLED="true"

# Require a CONFIRMED Devnet transaction signature before recording a bet/
# prediction. Defaults ON now that DEMO_MODE is opt-in; set "false" ONLY if you
# also enable NEXT_PUBLIC_DEMO_MODE=true and want unconfirmed local actions.
SOLANA_REQUIRE_ONCHAIN="true"

# Backend Solana config (devnet only — must NOT be mainnet).
SOLANA_NETWORK="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"

# -------- Contracts / Anchor / E2E (devnet, server-side) --------------------
# Authenticated devnet RPC used by the server, the Anchor program, and the
# on-chain E2E proof (`pnpm e2e` / `pnpm solana:health` / `pnpm solana:balance`).
# This is server-side only — safe to carry an API key (it never reaches the
# browser). Get a FREE devnet key from Alchemy / Helius / QuickNode. Devnet only.
ANCHOR_PROVIDER_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_KEY
# Local devnet signer keypair (gitignored). The E2E proof expects pubkey
# EBJjWqRqR6qidwo9qNNpaDvveX6A5PRD1avtxvDkVphA.
ANCHOR_WALLET=.devnet/id.json
# PROGRAM_ID=<your devnet program id after `anchor keys sync`>

# -------- Fast-bet SOL vault (devnet) ----------------------------------------
# Fast bets have NO instruction in the deployed program, so a round's stakes
# cannot sit in a PDA. Players transfer SOL to this vault and the server pays
# winners back out of it after settlement. Two levels:
#   FASTBET_VAULT_ADDRESS  -> stakes can be verified (players can bet)
#   FASTBET_VAULT_SECRET   -> winners can also be PAID (full loop)
# Set neither and the UI honestly reports fast-bet staking as unavailable
# instead of taking bets it cannot settle. Keep the vault funded with a little
# extra SOL for transaction fees.
#
# DEVNET ONLY: this is a hot key held by the server. Never point it at a wallet
# holding anything you care about.
# FASTBET_VAULT_ADDRESS="<vault pubkey>"
# FASTBET_VAULT_SECRET=".devnet/fastbet-vault.json"   # path or inline [1,2,...]

# Wallets that see the Admin link in the navbar. NAVIGATION ONLY — every
# privileged action is still authorised server-side by ADMIN_RESOLUTION_KEY.
# (The old gate checked `kyc_level >= 3`, which the profile API always returns
# as 0, so the link could never appear for anyone.)
# NEXT_PUBLIC_ADMIN_WALLETS="<wallet1>,<wallet2>"
