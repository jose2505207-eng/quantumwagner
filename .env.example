# =============================================================================
# Quantum Wager — frontend environment
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# All NEXT_PUBLIC_* vars are exposed to the browser — keep secrets out of them.
# =============================================================================

# Live REST backend base URL (no trailing slash).
# Defaults to the hosted backend if unset.
NEXT_PUBLIC_API_URL=https://quantum-wager.onrender.com

# App mode controls the honesty/demo behaviour:
#   development | demo  -> demo/seed data may be shown (always badged)
#   production          -> no demo fallbacks; real data or empty/error states
NEXT_PUBLIC_APP_MODE=development

# Force demo fallbacks on even in production (optional, "true"/unset).
# NEXT_PUBLIC_DEMO_MODE=true

# Solana network + RPC (devnet only — do NOT point at mainnet).
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# On-chain program id (Anchor prediction market program, devnet).
# NEXT_PUBLIC_PROGRAM_ID=C8SAQXW3qhWTT1uGdpSegU466qTQAKQs3JB15TQ8toSc
